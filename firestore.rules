rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Explicit default deny. Every future path remains closed until it gets
    // its own reviewed schema and ownership rule.
    match /{document=**} {
      allow read, write: if false;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidPortfolio(data) {
      return data.keys().hasOnly([
          'name',
          'baseCurrency',
          'archivedAt',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasAll([
          'name',
          'baseCurrency',
          'createdAt',
          'updatedAt'
        ]) &&
        data.name is string &&
        data.name.size() >= 1 &&
        data.name.size() <= 100 &&
        data.name.matches('[\\s\\S]*\\S[\\s\\S]*') &&
        data.baseCurrency is string &&
        data.baseCurrency == 'BRL' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        (!data.keys().hasAny(['archivedAt']) ||
          data.archivedAt == null ||
          data.archivedAt is timestamp);
    }

    function isAllowedArchiveTransition() {
      return (
        (
          !resource.data.keys().hasAny(['archivedAt']) &&
          (!request.resource.data.keys().hasAny(['archivedAt']) ||
            request.resource.data.archivedAt == null ||
            request.resource.data.archivedAt == request.time)
        ) || (
          resource.data.keys().hasAny(['archivedAt']) &&
          request.resource.data.keys().hasAny(['archivedAt']) &&
          (request.resource.data.archivedAt == resource.data.archivedAt ||
            request.resource.data.archivedAt == null ||
            request.resource.data.archivedAt == request.time)
        )
      ) && (
        !isArchiveStateChanged() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'archivedAt',
          'updatedAt'
        ])
      );
    }

    function isArchiveStateChanged() {
      return resource.data.keys().hasAny(['archivedAt']) !=
          request.resource.data.keys().hasAny(['archivedAt']) ||
        (resource.data.keys().hasAny(['archivedAt']) &&
          request.resource.data.keys().hasAny(['archivedAt']) &&
          resource.data.archivedAt != request.resource.data.archivedAt);
    }

    // The namespace is not a profile document in phase 005.
    match /users/{userId} {
      allow read, write: if false;
    }

    match /users/{userId}/portfolios/{portfolioId} {
      allow get, list: if isOwner(userId);

      allow create: if isOwner(userId) &&
        isValidPortfolio(request.resource.data) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        (!request.resource.data.keys().hasAny(['archivedAt']) ||
          request.resource.data.archivedAt == null);

      allow update: if isOwner(userId) &&
        isValidPortfolio(request.resource.data) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time &&
        isAllowedArchiveTransition();
    }

    // Future paths stay explicitly denied until their own task defines rules.
    match /users/{userId}/assets/{assetId} {
      allow read, write: if false;
    }

    match /users/{userId}/goals/{goalId} {
      allow read, write: if false;
    }

    match /users/{userId}/emergencyReserve {
      allow read, write: if false;
    }

    match /users/{userId}/portfolios/{portfolioId}/transactions/{transactionId} {
      allow read, write: if false;
    }

    match /users/{userId}/portfolios/{portfolioId}/allocationTargets/{targetId} {
      allow read, write: if false;
    }

    match /users/{userId}/portfolios/{portfolioId}/snapshots/{snapshotId} {
      allow read, write: if false;
    }
  }
}
